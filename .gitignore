# Dependencies
node_modules/
venv/
__pycache__/
*.pyc
.Python

# Environment
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Cache
.cache/
*.cache

# Generated assets (large files)
generated-assets/sprites/*.png
generated-assets/backgrounds/*.png
generated-assets/ui/*.png
generated-assets/audio/*.wav
generated-assets/audio/*.mp3

# Keep directory structure
!generated-assets/sprites/.gitkeep
!generated-assets/backgrounds/.gitkeep
!generated-assets/ui/.gitkeep
!generated-assets/audio/.gitkeep

# Test outputs
playwright-report/
test-results/

# Temporary files
*.tmp
.temp/

# Turbo Dash artifact builds - regenerated from src/index.html by
# build-artifact.mjs on every publish. src/artifact-build.html is the
# tracked reference copy; these two are disposable output.
games/endless-runner/src/turbo-dash.html
games/endless-runner/src/turbo-dash-cloud.html
# A symlinked node_modules is not a directory, so the rule above misses it.
games/endless-runner/test/node_modules
